# Copy to .env (git-ignored) for local runs, or set these in your host's secret manager.
# Server-side only. NEVER prefix with VITE_: anything with that prefix is shipped to the browser.
# Do not put real secrets in this file.

# --- AI provider (required for live GreenLens quests) ---
# OpenRouter API key. Without it /readyz returns 503 and /api/eco-quest returns 503 ai_unconfigured.
OPENROUTER_API_KEY=
# Preferred model. Fallback models in api/eco-quest.js are tried after it.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Signs quest tokens (16+ characters, random). Unset: a per-process secret is used and tokens
# stop working after a restart or across instances. Set it in any real deployment.
QUEST_SIGNING_SECRET=

# --- Server ---
# Set to "production" in deployments (the Dockerfile does). Disables the test-only switches below.
NODE_ENV=
# Listen port and interface.
PORT=8080
HOST=0.0.0.0
# Directory of the built SPA. Default: ./dist
DIST_DIR=
# Trust X-Forwarded-For for the client IP. Set to 1 only behind a proxy you control, else clients can spoof IPs.
TRUST_PROXY=
# Largest accepted request body in bytes (default 6291456 = 6 MB, sized for one compressed photo). Larger: 413 JSON.
MAX_BODY_BYTES=6291456
# Per-IP rate limit on /api/eco-quest: this many requests per window (token bucket). Over: 429 + Retry-After.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# --- Timeouts. Ordering, longest to shortest: client 45 s > server 40 s > upstream 30 s ---
# Whole API request. On expiry the client gets JSON 504. Must be < 45000 (client) and > UPSTREAM_TIMEOUT_MS.
SERVER_TIMEOUT_MS=40000
# One deadline shared by all upstream model attempts and retries.
UPSTREAM_TIMEOUT_MS=30000
# Retries for network errors, 429 and 5xx (0 to 2). Exponential backoff with jitter, never past the upstream deadline.
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BASE_MS=400
# Time allowed for in-flight requests to finish after SIGTERM before the process exits.
SHUTDOWN_TIMEOUT_MS=10000

# --- Test-only (e2e/unit tests). The server REFUSES TO START if these are set with NODE_ENV=production. ---
# AI_MOCK=1 answers from a built-in fake upstream so no real key is needed. /readyz reports "mock": true.
AI_MOCK=
# Send upstream calls to a local stub at this base URL (it receives POST <base>/chat/completions).
AI_BASE_URL=
